NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_JWT_KEY
# Optional newer Supabase key format (fallback if anon JWT not set):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: enables the AI layer of the list builder (reading a student's free-text
# activities into rated entries, and writing per-school coaching notes).
# Without it the builder still runs — odds and categories are computed from the
# Common Data Set figures, not from the model — it just shows no written notes.
# ANTHROPIC_API_KEY=sk-ant-...
